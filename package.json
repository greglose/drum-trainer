{
  "name": "drum-trainer",
  "version": "0.5.0",
  "description": "Practice drum patterns on an electronic kit over USB MIDI and get graded on timing, dynamics and hi-hat articulation. One HTML file, no backend.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:greglose/drum-trainer",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "smoke": "npm run build && node test/smoke/run.mjs",
    "check": "npm run lint && npm test && npm run smoke",
    "serve": "npm run build && npx --yes serve dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "playwright": "^1.56.0"
  }
}
